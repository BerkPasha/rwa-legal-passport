# =============================================================================
#  RWA Legal Passport - files that must never be committed
# =============================================================================

# ---- Secrets & local configuration -------------------------------------------
# Real settings and API keys live only in .env; the template stays committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets/
/secrets.json
service-account*.json
# Access-control policy with credential hashes (template: access_control.example.json)
access_control.json
# Showcase bundles and the fictional credentials of local demos (scripts/build_showcase.py,
# scripts/grant_demo.py). Written to scratch/ or a temporary directory by default; ignored
# anywhere, in case --out points into the repository
showcase-bundle/
evaluator-credentials.txt
demo-credentials.txt
rehearsal-context.json

# ---- Local databases ---------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
# Local database backups and every other artifact written next to them (migration scripts)
/backups/

# ---- Local scratch work --------------------------------------------------------
/scratch/
# Playwright output when run without scripts/e2e_run.py (which writes to scratch/e2e/)
frontend/test-results/
frontend/playwright-report/

# ---- Uploaded legal documents (STORAGE_PATH) ---------------------------------
storage/
uploads/
# Never commit legal documents by accident (test PDFs are generated in memory).
# If a document really belongs in the repo, add it explicitly: git add -f <file>
*.pdf
*.doc
*.docx
# Exception: the three synthetic, non-confidential real-producer test fixtures. Their SHA-256 values
# are pinned in tests/fixtures/real_pdfs/SHA256SUMS and checked by the tests, so no other PDF can
# take their place unnoticed (tests/fixtures/real_pdfs/README.md)
!tests/fixtures/real_pdfs/trust_prospectus.pdf
!tests/fixtures/real_pdfs/mixed_scanned.pdf
!tests/fixtures/real_pdfs/scanned_only.pdf

# ---- Python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# ---- Node / frontend ---------------------------------------------------------
node_modules/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Logs --------------------------------------------------------------------
*.log
logs/

# ---- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
