# RWA Legal Passport - read-only grant showcase: reverse proxy (DEPLOYMENT.md).
#
# PROPOSED CONFIGURATION, NOT TESTED WITH CADDY: Caddy was not available where it was written.
# Its rules were rehearsed with deploy/rehearsal_proxy.py, which implements the same routing and
# headers (scripts/e2e_run.py, environment "rehearsal"); validate this file with `caddy validate`
# on the server before use.
#
# - TLS: Caddy obtains and renews the certificate for SHOWCASE_DOMAIN automatically (HTTP-01/TLS-ALPN).
# - /api/*: the backend on 127.0.0.1:8000 (prefix removed), started with --proxy-headers and
#   --forwarded-allow-ips 127.0.0.1 so that rate limits see the visitor's address.
# - everything else: the static build in /srv/rwa-showcase/www, with single-page routing.
# Set SHOWCASE_DOMAIN in Caddy's environment, e.g. showcase.example.org.

{$SHOWCASE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# The API: same origin, no CORS needed. The backend adds its own security headers.
	handle_path /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8000
	}

	# The single-page application
	handle {
		root * /srv/rwa-showcase/www
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		@hashed path /static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@app not path /static/*
		header @app Cache-Control "no-cache"

		@notRead not method GET HEAD
		respond @notRead 405

		# Any path that is not a hashed file is the application (client-side routing). try_files runs
		# before file_server, so it is limited to those paths: a missing /static/ file stays a 404.
		try_files @app {path} /index.html
		file_server
	}
}
