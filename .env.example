# RWA Legal Passport - örnek ortam değişkenleri
# Kullanım: bu dosyayı ".env" adıyla kopyalayın ve değerleri .env içinde düzenleyin.
# Gerçek anahtarları ve şifreleri YALNIZCA .env dosyasına yazın; .env asla commit edilmez.

APP_NAME=RWA Legal Passport
APP_VERSION=0.1.0
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./rwa_legal_passport.db
MAX_UPLOAD_SIZE_MB=10
STORAGE_PATH=./storage

# AI servisi (Anthropic) - kendi anahtarınızı yalnızca .env dosyasına yazın.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL=claude-haiku-4-5-20251001

# İnceleyici token'ları (Authorization: Bearer) ve kurumsal API anahtarları (X-API-Key).
# Boş bırakılan değer devre dışıdır. Güçlü bir değer üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REVIEWER_ISSUER_TOKEN=
REVIEWER_LEGAL_TOKEN=
INSTITUTIONAL_API_KEY_ALPHA=
INSTITUTIONAL_API_KEY_BETA=
