# RWA Legal Passport - example environment variables
# Usage: copy this file to ".env" and edit the values in .env.
# Write real keys and passwords ONLY into the .env file; .env is never committed.

APP_NAME=RWA Legal Passport
APP_VERSION=0.1.0
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./rwa_legal_passport.db
MAX_UPLOAD_SIZE_MB=10
STORAGE_PATH=./storage

# Limits for parsing untrusted PDFs (Stage 9B-2)
MAX_PDF_PAGES=500
MAX_PDF_TEXT_CHARS=2000000
PDF_PARSE_TIMEOUT_SECONDS=30

# AI extraction (AI_EXTRACTION.md). disabled (default): no document text is sent to any AI service.
# anthropic: the text of a document version is sent to Anthropic, only for issuers with
# "external_ai_processing": true in access_control.json and after per-request confirmation.
AI_PROVIDER=disabled
# Write your own key only into the .env file; it is never logged or returned by the API.
ANTHROPIC_API_KEY=
# Supported with AI_PROVIDER=anthropic: claude-opus-5-5, claude-sonnet-5-5, claude-sonnet-4-6,
# claude-haiku-5-5, claude-haiku-4-5, claude-haiku-4-5-20251001
AI_MODEL=claude-opus-5-5
# Bounds per request: output tokens (1024-16000), model input characters (10000-1000000),
# pages (1-10000), timeout in seconds (10-600). One attempt per request, no automatic retries.
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_INPUT_CHARS=200000
AI_MAX_PAGES=200
AI_REQUEST_TIMEOUT_SECONDS=300

# Access control (Stage 9B-1): users, roles, issuer scopes and institutional
# API keys are defined in this JSON file. The file contains only SHA-256
# digests. Template: access_control.example.json — details: ACCESS_CONTROL.md
# If the file is missing, every protected endpoint is denied.
ACCESS_CONTROL_FILE=./access_control.json

# Origins allowed to reach the API from a browser (comma-separated). "*" is not accepted.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hourly AI extraction trigger limit per user (paid API cost control).
EXTRACTION_RATE_LIMIT_PER_HOUR=20

# Stellar TESTNET evidence anchoring (STELLAR_ANCHORING.md). The file holds the Testnet-only
# signing account; create it with: python scripts/stellar_testnet_setup.py
# Never commit it. Mainnet anchoring is not supported.
STELLAR_ANCHOR_SECRET_FILE=./secrets/stellar_testnet_anchor.json
STELLAR_ANCHOR_BASE_FEE=1000
STELLAR_ANCHOR_TX_TIMEOUT_SECONDS=300

# Showcase deployment policies (Stage 10C-1, GRANT_DEMO.md). Defaults: an ordinary writable server.
# READ_ONLY_MODE=true refuses every request other than GET, HEAD and OPTIONS (403), for any credential.
READ_ONLY_MODE=false
# Serve /docs, /redoc and /openapi.json. Turn off on public deployments.
API_DOCS_ENABLED=true
# Declare that all data on this server is synthetic (the interface labels every page). Demo datasets only.
SYNTHETIC_DATA_NOTICE=false
# Per client address and minute (Stage 10C-2, DEPLOYMENT.md); 0 = off. Behind a reverse proxy, start
# uvicorn with --proxy-headers --forwarded-allow-ips <proxy address> so the visitor's address is used.
CLIENT_RATE_LIMIT_PER_MINUTE=0
# After this many failed authentications (401) within a minute, an address gets 429 until the minute ends.
AUTH_FAILURE_LIMIT_PER_MINUTE=0

# DEPRECATED: REVIEWER_ISSUER_TOKEN, REVIEWER_LEGAL_TOKEN,
# INSTITUTIONAL_API_KEY_ALPHA, INSTITUTIONAL_API_KEY_BETA no longer authenticate anything.
# To keep an existing value, take its digest:
#   python -m app.access_tool hash-env REVIEWER_ISSUER_TOKEN
